  <main class="content-body">
    <p>Card treatments, side by side.</p>
  </main>
  <ul class="post-list">
    {{ postListItem({
      url: "/test/note/", fileSlug: "fixture-note",
      content: "<p>Has content.</p>",
      data: { altTitle: "A note", summary: "With a summary, so the blurb wraps.", tags: ["Type/Note"] }
    }, "01", true) }}
    {{ postListItem({
      url: "/test/link/", fileSlug: "fixture-link",
      content: "<p>Has commentary.</p>",
