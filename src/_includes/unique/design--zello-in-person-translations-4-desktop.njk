{# Extracted verbatim from the design post of the same name when work
   entries moved to the vault. Markup the workShot macro does not cover:
   a hand-written picture, or raw SVG includes. #}
<picture class="picture">
  <source
      media="(prefers-color-scheme: dark)"
      type="image/webp"
      srcset="
        https://cdn.dznr.me/design/zello-in-person-translations-4--dark.webp 1x,
        https://cdn.dznr.me/design/zello-in-person-translations-4--dark@2x.webp 2x,
        https://cdn.dznr.me/design/zello-in-person-translations-4--dark@3x.webp 3x
      "
    />
    <source
      media="(prefers-color-scheme: light)"
      type="image/webp"
      srcset="
        https://cdn.dznr.me/design/zello-in-person-translations-4--light.webp 1x,
        https://cdn.dznr.me/design/zello-in-person-translations-4--light@2x.webp 2x,
        https://cdn.dznr.me/design/zello-in-person-translations-4--light@3x.webp 3x
      "
    />
  
  <img
    src="https://cdn.dznr.me/design/zello-in-person-translations-4--light@2x.webp"
    srcset="
      https://cdn.dznr.me/design/zello-in-person-translations-4--light.webp 1x,
      https://cdn.dznr.me/design/zello-in-person-translations-4--light@2x.webp 2x,
      https://cdn.dznr.me/design/zello-in-person-translations-4--light@3x.webp 3x
    "
    alt="A landscape and portrait version of the same screen."
    loading="lazy"
    decoding="async"
  />
