{# The visual half of a work entry.

   The shot's configuration is authored in the vault as a `shot:` map mirroring
   workShot's arguments, with `alt:` hoisted alongside it because alt text is
   editorial and the asset paths are not. A post whose markup workShot cannot
   express names a `figure:` include instead, or as well. #}
{%- macro DesignShot(shot, alt, figure) -%}
  {%- if shot -%}
    {%- from "work-shot.njk" import workShot -%}
    {{ workShot(
        alt = alt if alt else '',
        frame = shot.frame,
        screen = shot.screen,
        video = shot.video,
        device = shot.device,
        class = shot.class if shot.class else ''
    ) }}
  {%- endif -%}
  {%- if figure %}{% include "unique/" + figure + ".njk" %}{% endif -%}
{%- endmacro -%}
